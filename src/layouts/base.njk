<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{{ title or "Clean Pools | Professional Pool Maintenance" }}</title>
    <meta name="description" content="{{ description or "Professional pool maintenance in Zanzibar. Clean Pools provides crystal-clear perfection for luxury villas and residences." }}"/>
    <meta name="theme-color" content="#0c4a6e"/>
    <link rel="canonical" href="https://cleanpools.co.tz{{ page.url }}"/>

    <!-- Preconnect for faster font load -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>

    <!-- Non-render-blocking font loading -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'"/>
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"/></noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" media="print" onload="this.media='all'"/>
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"/></noscript>

    <style>
        {% readFile "./src/assets/css/style.css" %}
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        body { font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif; }
        .skip-link { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
        .skip-link:focus { position: fixed; top: 0; left: 0; width: auto; height: auto; padding: 0.5rem 1rem; background: #0c4a6e; color: #fff; font-weight: 700; z-index: 9999; }
    </style>
    <script src="/assets/js/main.js" defer></script>
</head>
<body class="bg-surface text-on-background">
    <!-- Skip to main content for keyboard/screen reader users -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- TopNavBar -->
    <header class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-sky-100/50 shadow-[0_4px_20px_rgba(0,51,102,0.05)]">
        <nav class="flex justify-between items-center w-full px-10 py-4 max-w-7xl mx-auto font-medium" aria-label="Main navigation">
            <a class="text-xl font-bold tracking-tight text-sky-900 uppercase" href="/" aria-label="Clean Pools home">Clean Pools</a>
            <div class="hidden md:flex items-center space-x-8">
                <a class="{{ 'text-sky-600 font-bold border-b-2 border-sky-600 pb-1' if page.url == '/' else 'text-slate-600 hover:text-sky-800 transition-colors duration-200' }}" href="/" aria-current="{{ 'page' if page.url == '/' else false }}">Home</a>
                <a class="text-slate-600 hover:text-sky-800 transition-colors duration-200" href="#services">Services</a>
                <a class="text-slate-600 hover:text-sky-800 transition-colors duration-200" href="#pricing">Pricing</a>
                <a class="text-slate-600 hover:text-sky-800 transition-colors duration-200" href="#contact">Contact</a>
            </div>
            <div class="flex items-center space-x-4">
                <a href="/booking" class="bg-primary-container text-on-primary font-bold px-6 py-2.5 rounded-lg scale-95 active:scale-100 transition-transform shadow-md">Book Now</a>
            </div>
        </nav>
    </header>

    <main id="main-content">
        {{ content | safe }}
    </main>

    <footer class="bg-sky-900 text-white w-full border-t border-sky-800" id="contact">
        <div class="max-w-7xl mx-auto px-10 py-16 grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="space-y-6 col-span-1 md:col-span-1">
                <div class="text-lg font-bold text-sky-200 uppercase">Clean Pools</div>
                <p class="text-white text-sm leading-relaxed">Pristine Professionalism for Zanzibar's finest swimming pools. Local expertise, international standards.</p>
                <div class="flex space-x-4">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-full bg-sky-800 hover:bg-sky-700 transition-colors" aria-label="Clean Pools on Facebook"><span class="material-symbols-outlined text-sm" aria-hidden="true">facebook</span></a>
                    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-full bg-sky-800 hover:bg-sky-700 transition-colors" aria-label="Clean Pools on Instagram"><span class="material-symbols-outlined text-sm" aria-hidden="true">photo_camera</span></a>
                </div>
            </div>
            <div class="space-y-4">
                <div class="text-sky-200 font-bold uppercase tracking-widest text-xs">Quick Links</div>
                <ul class="space-y-2 text-white text-sm">
                    <li><a href="/" class="hover:text-sky-200 transition-colors">Home</a></li>
                    <li><a href="#services" class="hover:text-sky-200 transition-colors">Services</a></li>
                    <li><a href="/booking" class="hover:text-sky-200 transition-colors">Book a Service</a></li>
                    <li><a href="#pricing" class="hover:text-sky-200 transition-colors">Pool Guide</a></li>
                </ul>
            </div>
            <div class="space-y-4">
                <div class="text-sky-200 font-bold uppercase tracking-widest text-xs">Contact</div>
                <ul class="space-y-2 text-white text-sm">
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs" aria-hidden="true">call</span> +255 777 000 000</li>
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs" aria-hidden="true">mail</span> hello@cleanpools.co.tz</li>
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs" aria-hidden="true">location_on</span> Kiembe Samaki, Zanzibar</li>
                </ul>
            </div>
            <div class="space-y-4">
                <div class="text-sky-200 font-bold uppercase tracking-widest text-xs">Our Location</div>
                <div class="w-full h-40 rounded-xl overflow-hidden shadow-inner bg-slate-800">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126743.58585973748!2d39.176214!3d-6.165917!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x185cd0821213dfcd%3A0xc4730dfde40c1151!2sKiembe%20Samaki%2C%20Zanzibar!5e0!3m2!1sen!2stz!4v1716301234567!5m2!1sen!2stz" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location of Clean Pools in Kiembe Samaki, Zanzibar"></iframe>
                </div>
            </div>
        </div>
        <div class="w-full px-10 py-6 border-t border-sky-800 text-center text-white text-xs">
            © 2025 Clean Pools Zanzibar. Pristine Professionalism.
        </div>
    </footer>
</body>
</html>
