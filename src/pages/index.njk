---
layout: base.njk
title: "Clean Pools | Professional Pool Maintenance"
description: "Professional pool maintenance in Zanzibar. Clean Pools provides crystal-clear perfection for luxury villas and residences."
permalink: /index.html
---

<!-- Hero Section -->
<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
    <div class="absolute inset-0 z-0">
        {% image "./src/assets/img/hero.jpg", "A luxurious, crystal-clear infinity pool overlooking the turquoise waters of the Zanzibar coast at sunset.", "100vw", "eager", "high", "absolute inset-0 w-full h-full object-cover" %}
        <div class="absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-10 w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-900 text-xs font-bold">
                <span class="material-symbols-outlined text-[16px]">location_on</span>
                Kiembe Samaki, Zanzibar
            </div>
            <h1 class="text-5xl md:text-7xl font-bold text-sky-900 leading-tight">
                Pristine Pools, Island Living.
            </h1>
            <p class="text-lg text-slate-700 max-w-lg">
                Experience the tranquility of a perfectly balanced pool. Clean Pools delivers professional maintenance tailored to the unique climate of Zanzibar.
            </p>
            <div class="flex gap-4">
                <a href="/booking" class="px-8 py-4 bg-sky-900 text-white font-bold rounded-xl shadow-lg hover:bg-sky-800 transition-all">Book Your Cleaning</a>
                <button class="px-8 py-4 border-2 border-sky-700 text-sky-700 font-bold rounded-xl hover:bg-sky-50 transition-all">View Our Work</button>
            </div>
        </div>
        <div class="hidden md:block">
            <div class="bg-white/40 backdrop-blur-xl border border-white/50 p-8 rounded-3xl shadow-2xl space-y-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-sky-100 flex items-center justify-center text-sky-700">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">water_drop</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-sky-900">Water Quality</h3>
                        <p class="text-sm text-slate-700">Real-time balancing</p>
                    </div>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-center text-sm font-medium">
                        <span>pH Balance</span>
                        <span class="text-sky-700 font-bold">7.4 pH</span>
                    </div>
                    <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
                        <div class="h-full w-[74%] bg-sky-500"></div>
                    </div>
                    <div class="flex justify-between items-center text-sm font-medium">
                        <span>Chlorine</span>
                        <span class="text-sky-700 font-bold">2.5 ppm</span>
                    </div>
                    <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
                        <div class="h-full w-[60%] bg-sky-500"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-24 bg-sky-50" id="services">
    <div class="max-w-7xl mx-auto px-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <div class="md:col-span-8 bg-white p-12 rounded-3xl border border-sky-100 shadow-sm flex flex-col justify-between">
                <div class="space-y-6">
                    <h2 class="text-4xl font-bold text-sky-900">Deeply Rooted in Kiembe Samaki</h2>
                    <p class="text-lg text-slate-700 max-w-xl leading-relaxed">
                        We aren't just a service provider; we are part of the Zanzibar fabric. Clean Pools was founded on the principle of providing reliable, professional jobs for our local community while maintaining the highest international standards for our island's luxury villas and residences.
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-8 mt-12">
                    <div>
                        <div class="text-5xl text-sky-700 font-bold">100%</div>
                        <div class="text-sm uppercase tracking-wider text-slate-700 font-bold mt-2">Local Team</div>
                    </div>
                    <div>
                        <div class="text-5xl text-sky-700 font-bold">24h</div>
                        <div class="text-sm uppercase tracking-wider text-slate-700 font-bold mt-2">Response Time</div>
                    </div>
                </div>
            </div>
            <div class="md:col-span-4 h-full">
                {% image "./src/assets/img/technician.jpg", "Professional pool technician testing water.", "100vw" %}
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section class="py-24 bg-white" id="pricing">
    <div class="max-w-7xl mx-auto px-10 text-center space-y-4 mb-16">
        <h2 class="text-4xl font-bold text-sky-900">Transparent Maintenance Plans</h2>
        <p class="text-lg text-slate-700">Pristine results, tailored to your pool's specific needs.</p>
    </div>
    <div class="max-w-7xl mx-auto px-10 grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Plans... -->
        {% set plans = [
            { name: "Basic Splash", price: "49", features: ["Bi-weekly surface skimming", "Filter basket cleaning", "Basic chemical testing"] },
            { name: "Deep Dive", price: "89", featured: true, features: ["Weekly full-service cleaning", "Wall & floor scrubbing", "Premium chemical balancing", "Monthly pump inspection"] },
            { name: "Premium Maintenance", price: "149", features: ["3x Weekly comprehensive cleaning", "Priority emergency support", "Equipment repair discounts", "Saltwater cell optimization"] }
        ] %}

        {% for plan in plans %}
        <div class="p-8 rounded-3xl border {{ 'border-sky-700 bg-sky-50 shadow-2xl relative transform -translate-y-4' if plan.featured else 'border-slate-200 hover:border-sky-300 bg-white transition-all' }} group">
            {% if plan.featured %}<div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-sky-700 text-white px-4 py-1 rounded-full text-xs font-bold uppercase">Most Popular</div>{% endif %}
            <div class="text-sky-900 font-bold mb-2">{{ plan.name }}</div>
            <div class="text-5xl font-bold text-sky-900 mb-6">${{ plan.price }}<span class="text-sm font-normal text-slate-700">/mo</span></div>
            <ul class="space-y-4 mb-8 text-left">
                {% for feature in plan.features %}
                <li class="flex items-center gap-3 text-sm text-slate-700">
                    <span class="material-symbols-outlined text-sky-700">check_circle</span>
                    {{ feature }}
                </li>
                {% endfor %}
            </ul>
            <button class="w-full py-4 rounded-xl border-2 {{ 'bg-sky-900 text-white border-sky-900' if plan.featured else 'border-sky-900 text-sky-900 hover:bg-sky-900 hover:text-white' }} font-bold transition-all">Select Plan</button>
        </div>
        {% endfor %}
    </div>
</section>

<!-- Final CTA Section -->
<section class="py-24 relative overflow-hidden bg-sky-950">
    <div class="absolute top-0 right-0 w-1/3 h-full opacity-20">
        {% image "./src/assets/img/water.jpg", "Crystal clear pool water.", "33vw" %}
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-10">
        <div class="max-w-2xl space-y-8">
            <h2 class="text-5xl font-bold text-white leading-tight">Keep your pool crystal clear.</h2>
            <p class="text-lg text-sky-100">
                Join dozens of villas in Zanzibar that trust Clean Pools for daily, weekly, and monthly maintenance. Let us handle the chemistry while you enjoy the water.
            </p>
            <div class="flex flex-wrap gap-6">
                <button class="px-10 py-5 bg-sky-400 text-sky-950 font-black rounded-2xl text-lg shadow-xl hover:scale-105 transition-transform">Schedule Inspection</button>
                <div class="flex items-center gap-4 text-white">
                    <div class="flex -space-x-2">
                        <div class="w-10 h-10 rounded-full border-2 border-sky-900 bg-slate-300"></div>
                        <div class="w-10 h-10 rounded-full border-2 border-sky-900 bg-slate-400"></div>
                        <div class="w-10 h-10 rounded-full border-2 border-sky-900 bg-slate-500"></div>
                    </div>
                    <span class="text-sm font-bold">Trusted by 50+ local villas</span>
                </div>
            </div>
        </div>
    </div>
</section>
