---
layout: base.njk
title: "Book a Service - Clean Pools"
description: "Book a pool maintenance service with Clean Pools in Zanzibar."
permalink: /booking.html
---

<main class="pt-32 pb-24 px-6 max-w-5xl mx-auto">
    <div class="mb-12 text-center">
        <h1 class="text-5xl font-bold text-sky-900 mb-2">Schedule Your Clarity</h1>
        <p class="text-lg text-slate-700">Transform your pool into a pristine Zanzibari oasis in just four simple steps.</p>
    </div>

    <!-- Progress Indicator -->
    <div class="flex justify-between mb-12 relative">
        <div class="absolute top-1/2 left-0 w-full h-0.5 bg-slate-200 -z-10 -translate-y-1/2"></div>
        {% for step in [1, 2, 3, 4] %}
        <div class="flex flex-col items-center gap-2 bg-white px-4">
            <div class="w-10 h-10 rounded-full border-2 flex items-center justify-center {{ 'bg-sky-700 text-white border-sky-700' if step == 1 else 'border-slate-300 text-slate-400 bg-white' }}">{{ step }}</div>
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">{{ ["Size", "Service", "Schedule", "Contact"][step-1] }}</span>
        </div>
        {% endfor %}
    </div>

    <!-- Booking Form Container -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <!-- Main Content Area -->
        <div class="md:col-span-8 space-y-8">
            <!-- Step 1: Select Pool Size -->
            <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-700">straighten</span>
                    1. Select Pool Size
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    {% for size in [
                        { id: "small", label: "Small", desc: "Up to 15,000 gal", icon: "pool" },
                        { id: "medium", label: "Medium", desc: "15,000 - 30,000 gal", icon: "waves", checked: true },
                        { id: "large", label: "Large", desc: "30,000+ gal", icon: "water" }
                    ] %}
                    <label class="relative group cursor-pointer">
                        <input {{ 'checked' if size.checked }} class="peer sr-only" name="pool_size" type="radio"/>
                        <div class="p-6 border-2 border-slate-100 rounded-2xl text-center transition-all peer-checked:border-sky-700 peer-checked:bg-sky-50 hover:border-sky-200">
                            <span class="material-symbols-outlined text-4xl mb-2 text-sky-700">{{ size.icon }}</span>
                            <div class="font-bold text-sky-900">{{ size.label }}</div>
                            <div class="text-xs text-slate-700">{{ size.desc }}</div>
                        </div>
                    </label>
                    {% endfor %}
                </div>
            </section>

            <!-- Step 2: Choose Service Type -->
            <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-700">cleaning_services</span>
                    2. Choose Service Type
                </h2>
                <div class="space-y-4">
                    {% for service in [
                        { name: "Weekly Maintenance", desc: "Full chemical balance, vacuuming, and filter inspection.", price: "75/wk" },
                        { name: "One-time Deep Clean", desc: "Heavy scrubbing, shock treatment, and debris removal.", price: "150", checked: true },
                        { name: "Equipment Repair", desc: "Pump, heater, or light diagnostics and fixing.", price: "Quote" }
                    ] %}
                    <label class="flex items-center gap-4 p-6 border border-slate-100 rounded-2xl cursor-pointer hover:bg-sky-50 transition-colors group">
                        <input {{ 'checked' if service.checked }} class="w-5 h-5 text-sky-700 focus:ring-sky-600 border-slate-300" name="service_type" type="radio"/>
                        <div class="flex-1">
                            <div class="font-bold text-sky-900">{{ service.name }}</div>
                            <div class="text-sm text-slate-700">{{ service.desc }}</div>
                        </div>
                        <div class="text-sky-700 font-bold">${{ service.price }}</div>
                    </label>
                    {% endfor %}
                </div>
            </section>

            <!-- Step 3: Schedule Date & Time -->
            <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-700">calendar_month</span>
                    3. Schedule Date &amp; Time
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-sky-900 mb-2">Preferred Date</label>
                        <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" type="date"/>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-sky-900 mb-2">Preferred Window</label>
                        <select class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600">
                            <option>Morning (8:00 AM - 12:00 PM)</option>
                            <option>Afternoon (12:00 PM - 4:00 PM)</option>
                            <option>Evening (4:00 PM - 7:00 PM)</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- Step 4: Contact Details -->
            <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-700">person_pin_circle</span>
                    4. Contact Details
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-bold text-sky-900 mb-2">Full Name</label>
                        <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" placeholder="John Doe" type="text"/>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-sky-900 mb-2">Email Address</label>
                        <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" placeholder="john@example.com" type="email"/>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-sky-900 mb-2">Phone Number</label>
                        <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" placeholder="+255 123 456 789" type="tel"/>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-bold text-sky-900 mb-2">Service Address</label>
                        <textarea class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" placeholder="Street name, villa number, area..." rows="3"></textarea>
                    </div>
                </div>
            </section>

            <div class="flex justify-end">
                <a href="/confirmed" class="px-12 py-4 bg-sky-900 text-white rounded-xl font-bold shadow-lg hover:bg-sky-800 transition-all active:scale-95">
                    Confirm Booking
                </a>
            </div>
        </div>

        <!-- Summary Sidebar -->
        <div class="md:col-span-4">
            <div class="sticky top-32 space-y-8">
                <div class="bg-sky-50 p-6 rounded-3xl border border-sky-100">
                    <h3 class="text-xl font-bold text-sky-900 mb-6">Summary</h3>
                    <div class="space-y-4">
                        <div class="flex justify-between border-b border-sky-100 pb-2">
                            <span class="text-slate-700">Pool Size</span>
                            <span class="font-bold text-sky-900">Medium</span>
                        </div>
                        <div class="flex justify-between border-b border-sky-100 pb-2">
                            <span class="text-slate-700">Service</span>
                            <span class="font-bold text-sky-900">One-time Deep Clean</span>
                        </div>
                        <div class="flex justify-between border-b border-sky-100 pb-2">
                            <span class="text-slate-700">Base Rate</span>
                            <span class="font-bold text-sky-900">$150.00</span>
                        </div>
                        <div class="flex justify-between border-b border-sky-100 pb-2">
                            <span class="text-slate-700">Zanzibar Tax</span>
                            <span class="font-bold text-sky-900">$12.00</span>
                        </div>
                        <div class="flex justify-between pt-2">
                            <span class="text-xl font-bold text-sky-900">Total</span>
                            <span class="text-xl font-bold text-sky-700">$162.00</span>
                        </div>
                    </div>
                </div>
                <div class="rounded-3xl overflow-hidden shadow-sm border border-slate-100">
                    {% image "./src/assets/img/luxury-pool.jpg", "Luxury Pool", "400px" %}
                    <div class="p-6 bg-white">
                        <p class="text-sm italic text-slate-700">"The cleanest pool I've had in 10 years of living in Zanzibar." — Amina S.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
