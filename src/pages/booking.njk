---
layout: base.njk
title: "Book a Service - Clean Pools"
description: "Book a pool maintenance service with Clean Pools in Zanzibar."
permalink: /booking.html
---

<div class="pt-32 pb-24 px-6 max-w-5xl mx-auto">
    <div class="mb-12 text-center">
        <h1 class="text-5xl font-bold text-sky-900 mb-2">Schedule Your Clarity</h1>
        <p class="text-lg text-slate-700">Transform your pool into a pristine Zanzibari oasis in just four simple steps.</p>
    </div>

    <!-- Progress Indicator -->
    <div class="flex justify-between mb-12 relative" role="list" aria-label="Booking steps">
        <div class="absolute top-1/2 left-0 w-full h-0.5 bg-slate-200 -z-10 -translate-y-1/2" aria-hidden="true"></div>
        {% for step in [1, 2, 3, 4] %}
        <div class="flex flex-col items-center gap-2 bg-white px-4" role="listitem">
            <div class="w-10 h-10 rounded-full border-2 flex items-center justify-center {{ 'bg-sky-700 text-white border-sky-700' if step == 1 else 'border-slate-300 text-slate-400 bg-white' }}" aria-label="Step {{ step }}: {{ ['Size', 'Service', 'Schedule', 'Contact'][step-1] }}">{{ step }}</div>
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">{{ ["Size", "Service", "Schedule", "Contact"][step-1] }}</span>
        </div>
        {% endfor %}
    </div>

    <!-- Booking Form -->
    <form id="booking-form" novalidate>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <!-- Main Content Area -->
            <div class="md:col-span-8 space-y-8">
                <!-- Step 1: Select Pool Size -->
                <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                    <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sky-700" aria-hidden="true">straighten</span>
                        1. Select Pool Size
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        {% for size in [
                            { id: "small", label: "Small", desc: "Up to 15,000 gal", icon: "pool" },
                            { id: "medium", label: "Medium", desc: "15,000 - 30,000 gal", icon: "waves", checked: true },
                            { id: "large", label: "Large", desc: "30,000+ gal", icon: "water" }
                        ] %}
                        <label class="relative group cursor-pointer">
                            <input {{ 'checked' if size.checked }} class="peer sr-only" id="size-{{ size.id }}" name="pool_size" type="radio" value="{{ size.id }}"/>
                            <div class="p-6 border-2 border-slate-100 rounded-2xl text-center transition-all peer-checked:border-sky-700 peer-checked:bg-sky-50 hover:border-sky-200">
                                <span class="material-symbols-outlined text-4xl mb-2 text-sky-700" aria-hidden="true">{{ size.icon }}</span>
                                <div class="font-bold text-sky-900">{{ size.label }}</div>
                                <div class="text-xs text-slate-700">{{ size.desc }}</div>
                            </div>
                        </label>
                        {% endfor %}
                    </div>
                </section>

                <!-- Step 2: Choose Service Type -->
                <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                    <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sky-700" aria-hidden="true">cleaning_services</span>
                        2. Choose Service Type
                    </h2>
                    <div class="space-y-4">
                        {% for service in [
                            { id: "weekly", name: "Weekly Maintenance", desc: "Full chemical balance, vacuuming, and filter inspection.", price: "75/wk" },
                            { id: "deep", name: "One-time Deep Clean", desc: "Heavy scrubbing, shock treatment, and debris removal.", price: "150", checked: true },
                            { id: "repair", name: "Equipment Repair", desc: "Pump, heater, or light diagnostics and fixing.", price: "Quote" }
                        ] %}
                        <label class="flex items-center gap-4 p-6 border border-slate-100 rounded-2xl cursor-pointer hover:bg-sky-50 transition-colors group">
                            <input {{ 'checked' if service.checked }} class="w-5 h-5 text-sky-700 focus:ring-sky-600 border-slate-300" id="service-{{ service.id }}" name="service_type" type="radio" value="{{ service.id }}"/>
                            <div class="flex-1">
                                <div class="font-bold text-sky-900">{{ service.name }}</div>
                                <div class="text-sm text-slate-700">{{ service.desc }}</div>
                            </div>
                            <div class="text-sky-700 font-bold" aria-label="Price: ${{ service.price }}">${{ service.price }}</div>
                        </label>
                        {% endfor %}
                    </div>
                </section>

                <!-- Step 3: Schedule Date & Time -->
                <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                    <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sky-700" aria-hidden="true">calendar_month</span>
                        3. Schedule Date &amp; Time
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-sky-900 mb-2" for="preferred-date">Preferred Date</label>
                            <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" id="preferred-date" name="preferred_date" type="date" required/>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-sky-900 mb-2" for="preferred-window">Preferred Window</label>
                            <select class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" id="preferred-window" name="preferred_window">
                                <option value="morning">Morning (8:00 AM - 12:00 PM)</option>
                                <option value="afternoon">Afternoon (12:00 PM - 4:00 PM)</option>
                                <option value="evening">Evening (4:00 PM - 7:00 PM)</option>
                            </select>
                        </div>
                    </div>
                </section>

                <!-- Step 4: Contact Details -->
                <section class="bg-white p-8 rounded-3xl shadow-sm border border-sky-100">
                    <h2 class="text-xl font-bold text-sky-900 mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sky-700" aria-hidden="true">person_pin_circle</span>
                        4. Contact Details
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="sm:col-span-2">
                            <label class="block text-sm font-bold text-sky-900 mb-2" for="full-name">Full Name</label>
                            <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" id="full-name" name="full_name" placeholder="John Doe" type="text" required autocomplete="name"/>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-sky-900 mb-2" for="email">Email Address</label>
                            <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" id="email" name="email" placeholder="john@example.com" type="email" required autocomplete="email"/>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-sky-900 mb-2" for="phone">Phone Number</label>
                            <input class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" id="phone" name="phone" placeholder="+255 123 456 789" type="tel" autocomplete="tel"/>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-sm font-bold text-sky-900 mb-2" for="address">Service Address</label>
                            <textarea class="w-full p-4 border border-slate-200 rounded-xl focus:border-sky-700 focus:ring-sky-600" id="address" name="address" placeholder="Street name, villa number, area..." rows="3" autocomplete="street-address"></textarea>
                        </div>
                    </div>
                </section>

                <div id="booking-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm" role="alert"></div>

                <div class="flex justify-end">
                    <button type="submit" class="px-12 py-4 bg-sky-900 text-white rounded-xl font-bold shadow-lg hover:bg-sky-800 transition-all active:scale-95">
                        Confirm Booking
                    </button>
                </div>
            </div>

            <!-- Summary Sidebar -->
            <div class="md:col-span-4">
                <div class="sticky top-32 space-y-8">
                    <div class="bg-sky-50 p-6 rounded-3xl border border-sky-100" aria-label="Booking summary">
                        <h2 class="text-xl font-bold text-sky-900 mb-6">Summary</h2>
                        <div class="space-y-4">
                            <div class="flex justify-between border-b border-sky-100 pb-2">
                                <span class="text-slate-700">Pool Size</span>
                                <span class="font-bold text-sky-900" id="summary-size">Medium</span>
                            </div>
                            <div class="flex justify-between border-b border-sky-100 pb-2">
                                <span class="text-slate-700">Service</span>
                                <span class="font-bold text-sky-900" id="summary-service">One-time Deep Clean</span>
                            </div>
                            <div class="flex justify-between border-b border-sky-100 pb-2">
                                <span class="text-slate-700">Base Rate</span>
                                <span class="font-bold text-sky-900" id="summary-rate">$150.00</span>
                            </div>
                            <div class="flex justify-between border-b border-sky-100 pb-2">
                                <span class="text-slate-700">Zanzibar Tax</span>
                                <span class="font-bold text-sky-900" id="summary-tax">$12.00</span>
                            </div>
                            <div class="flex justify-between pt-2">
                                <span class="text-xl font-bold text-sky-900">Total</span>
                                <span class="text-xl font-bold text-sky-700" id="summary-total">$162.00</span>
                            </div>
                        </div>
                    </div>
                    <div class="rounded-3xl overflow-hidden shadow-sm border border-slate-100">
                        {% image "./src/assets/img/luxury-pool.jpg", "Luxury pool maintained by Clean Pools Zanzibar.", "400px" %}
                        <div class="p-6 bg-white">
                            <p class="text-sm italic text-slate-700">"The cleanest pool I've had in 10 years of living in Zanzibar." — Amina S.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
