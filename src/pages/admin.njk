---
permalink: /admin.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Operations Dashboard | Clean Pools</title>
    <meta name="robots" content="noindex, nofollow"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"/>
    <style>
        *,::before,::after{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Plus Jakarta Sans',ui-sans-serif,system-ui,sans-serif;background:#f7f9fb;color:#191c1e;min-height:100vh}
        .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;font-size:20px;vertical-align:middle}
        a{color:inherit;text-decoration:none}
        button{cursor:pointer;font-family:inherit}

        /* Layout */
        .layout{display:flex;min-height:100vh}
        .sidebar{width:240px;background:#f0f9ff;border-right:1px solid #e0f2fe;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;flex-shrink:0}
        .sidebar-logo{padding:1.5rem;border-bottom:1px solid #e0f2fe}
        .sidebar-logo h1{font-size:.9rem;font-weight:900;color:#0c4a6e;text-transform:uppercase;letter-spacing:.05em}
        .sidebar-logo p{font-size:.7rem;color:#0284c7;opacity:.7;font-weight:600;text-transform:uppercase;margin-top:.2rem}
        .sidebar-nav{flex:1;padding:.75rem .5rem;display:flex;flex-direction:column;gap:.25rem}
        .sidebar-nav a{display:flex;align-items:center;gap:.75rem;padding:.65rem 1rem;border-radius:.5rem;font-size:.85rem;color:#64748b;transition:all .15s}
        .sidebar-nav a:hover{background:#bae6fd30;color:#0c4a6e;transform:translateX(2px)}
        .sidebar-nav a.active{background:#fff;color:#0284c7;font-weight:600;box-shadow:0 1px 3px rgba(0,51,102,.08)}
        .sidebar-footer{padding:.75rem .5rem;border-top:1px solid #e0f2fe;display:flex;flex-direction:column;gap:.25rem}
        .sidebar-footer a{display:flex;align-items:center;gap:.75rem;padding:.65rem 1rem;border-radius:.5rem;font-size:.85rem;color:#64748b;cursor:pointer;transition:all .15s}
        .sidebar-footer a:hover{background:#fee2e2;color:#dc2626}

        /* Main */
        .main{flex:1;padding:2rem 2.5rem;overflow-y:auto}

        /* Header */
        .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem}
        .page-header-left h2{font-size:1.6rem;font-weight:700;color:#001e40}
        .page-header-left p{font-size:.875rem;color:#43474f;margin-top:.2rem}
        .admin-badge{display:flex;align-items:center;gap:.75rem;background:#fff;padding:.75rem 1rem;border-radius:.75rem;border:1px solid #e0f2fe;box-shadow:0 2px 8px rgba(0,51,102,.05)}
        .admin-badge span{font-size:.85rem;font-weight:700;color:#0c4a6e}
        .admin-badge small{font-size:.65rem;color:#0284c7;font-weight:700;text-transform:uppercase;display:block}

        /* Stats grid */
        .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-bottom:2rem}
        .stat-card{background:#fff;border-radius:.75rem;padding:1.25rem;border:1px solid #f0f9ff;box-shadow:0 2px 12px rgba(0,51,102,.05)}
        .stat-card-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem}
        .stat-icon{padding:.5rem;border-radius:.5rem;display:flex}
        .stat-icon.blue{background:#e0f2fe;color:#0284c7}
        .stat-icon.orange{background:#fff7ed;color:#ea580c}
        .stat-icon.green{background:#f0fdf4;color:#16a34a}
        .stat-badge{font-size:.7rem;font-weight:700;padding:.2rem .6rem;border-radius:9999px}
        .stat-badge.green{background:#dcfce7;color:#15803d}
        .stat-badge.orange{background:#fff7ed;color:#c2410c}
        .stat-label{font-size:.65rem;color:#64748b;text-transform:uppercase;letter-spacing:.08em;font-weight:700}
        .stat-value{font-size:2.5rem;font-weight:700;color:#001e40;line-height:1.1;margin-top:.25rem}
        .stat-sub{font-size:.75rem;color:#16a34a;font-weight:700;display:flex;align-items:center;gap:.25rem;margin-top:.5rem}

        /* Bookings table */
        .section-card{background:#fff;border-radius:.75rem;border:1px solid #e0f2fe;overflow:hidden;margin-bottom:2rem}
        .section-header{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;background:#f0f9ff40;border-bottom:1px solid #e0f2fe}
        .section-header h3{font-size:1.1rem;font-weight:700;color:#001e40}
        .btn-sm{display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .9rem;border:1px solid #bae6fd;border-radius:.5rem;font-size:.8rem;font-weight:600;color:#0c4a6e;background:#fff;cursor:pointer;transition:background .15s}
        .btn-sm:hover{background:#f0f9ff}
        table{width:100%;border-collapse:collapse}
        thead tr{background:#f0f9ff80}
        th{padding:.75rem 1.25rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#0c4a6e;text-align:left}
        td{padding:1rem 1.25rem;font-size:.85rem;border-top:1px solid #f0f9ff;vertical-align:middle}
        tbody tr:hover{background:#f0f9ff20}
        .avatar{width:2rem;height:2rem;border-radius:9999px;background:#e0f2fe;color:#0284c7;font-weight:700;font-size:.7rem;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
        .badge{display:inline-flex;align-items:center;padding:.2rem .6rem;border-radius:9999px;font-size:.7rem;font-weight:600}
        .badge.pristine{background:#dcfce7;color:#15803d}
        .badge.attention{background:#fff7ed;color:#c2410c}
        .badge.ready{background:#e0f2fe;color:#0369a1}
        .badge.cleaned{background:#dcfce7;color:#15803d}
        .time{font-size:.85rem;font-weight:600;color:#001e40}
        .btn-icon{background:none;border:none;color:#0284c7;cursor:pointer;padding:.25rem}
        .btn-icon:hover{color:#0c4a6e}

        /* Bottom cards */
        .bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}
        .insight-card{background:#003366;color:#fff;border-radius:.75rem;padding:1.5rem;position:relative;overflow:hidden}
        .insight-card h4{font-size:1rem;font-weight:700;margin-bottom:.5rem}
        .insight-card p{font-size:.8rem;opacity:.85;line-height:1.6;margin-bottom:1.25rem}
        .insight-icon{position:absolute;right:-1rem;bottom:-1rem;font-size:6rem;opacity:.1}
        .btn-outline-white{background:#0284c7;color:#fff;border:none;padding:.5rem 1.25rem;border-radius:.5rem;font-size:.8rem;font-weight:700;cursor:pointer;position:relative;z-index:1}
        .hero-upload-card{background:#fff;border-radius:.75rem;padding:1.5rem;border:1px solid #e0f2fe;box-shadow:0 2px 12px rgba(0,51,102,.05)}
        .hero-upload-card h4{font-size:.95rem;font-weight:700;color:#001e40;margin-bottom:.5rem}
        .hero-upload-card p{font-size:.78rem;color:#43474f;margin-bottom:1rem}
        .upload-area{border:2px dashed #bae6fd;border-radius:.75rem;padding:1.5rem;text-align:center;cursor:pointer;transition:border-color .15s}
        .upload-area:hover{border-color:#0284c7}
        .upload-area input{display:none}
        .upload-area label{cursor:pointer;display:block}
        .upload-area .upload-icon{font-size:2rem;color:#0284c7;margin-bottom:.5rem}
        .upload-area .upload-text{font-size:.8rem;color:#64748b}
        .upload-area .upload-text strong{color:#0284c7}
        .upload-status{margin-top:.75rem;font-size:.78rem;font-weight:600;display:none}
        .upload-status.success{color:#16a34a;display:block}
        .upload-status.error{color:#dc2626;display:block}

        /* Loading & empty states */
        .loading-row td{text-align:center;color:#64748b;padding:2rem}
        .spinner{width:1.25rem;height:1.25rem;border:2px solid #e0f2fe;border-top-color:#0284c7;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;vertical-align:middle;margin-right:.5rem}
        @keyframes spin{to{transform:rotate(360deg)}}

        @media(max-width:768px){
            .sidebar{display:none}
            .stats-grid{grid-template-columns:1fr}
            .bottom-grid{grid-template-columns:1fr}
            .main{padding:1.25rem}
        }
    </style>
</head>
<body>

<div class="layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <h1>Clean Pools Admin</h1>
            <p>Zanzibar Branch</p>
        </div>
        <nav class="sidebar-nav" aria-label="Admin navigation">
            <a href="#" class="active">
                <span class="material-symbols-outlined">dashboard</span>
                Dashboard
            </a>
            <a href="#">
                <span class="material-symbols-outlined">calendar_today</span>
                Upcoming Jobs
            </a>
            <a href="#">
                <span class="material-symbols-outlined">history_edu</span>
                Service History
            </a>
            <a href="#">
                <span class="material-symbols-outlined">receipt_long</span>
                Invoices
            </a>
            <a href="#">
                <span class="material-symbols-outlined">settings</span>
                Settings
            </a>
        </nav>
        <div class="sidebar-footer">
            <a href="#" id="logout-btn">
                <span class="material-symbols-outlined">logout</span>
                Logout
            </a>
        </div>
    </aside>

    <!-- Main content -->
    <main class="main">
        <!-- Header -->
        <div class="page-header">
            <div class="page-header-left">
                <h1>Welcome back, Admin</h1>
                <p>Operations overview — Stone Town &amp; surrounding areas</p>
            </div>
            <div class="admin-badge">
                <span class="material-symbols-outlined" style="color:#0284c7">manage_accounts</span>
                <div>
                    <span>Operations Manager</span>
                    <small>Zanzibar HQ</small>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid" role="list" aria-label="Key metrics">
            <div class="stat-card" role="listitem">
                <div class="stat-card-header">
                    <div class="stat-icon blue"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">water_drop</span></div>
                    <span class="stat-badge green" id="jobs-badge">Loading…</span>
                </div>
                <p class="stat-label">Bookings (Total)</p>
                <p class="stat-value" id="stat-bookings">—</p>
                <p class="stat-sub"><span class="material-symbols-outlined" style="font-size:14px">trending_up</span> via Netlify Blobs</p>
            </div>
            <div class="stat-card" role="listitem">
                <div class="stat-card-header">
                    <div class="stat-icon orange"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">pending_actions</span></div>
                    <span class="stat-badge orange">Attention needed</span>
                </div>
                <p class="stat-label">Pending Invoices</p>
                <p class="stat-value">8</p>
            </div>
            <div class="stat-card" role="listitem">
                <div class="stat-card-header">
                    <div class="stat-icon green"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">payments</span></div>
                    <span class="stat-badge green">Record month</span>
                </div>
                <p class="stat-label">Monthly Revenue</p>
                <p class="stat-value">$12,450</p>
                <p class="stat-sub"><span class="material-symbols-outlined" style="font-size:14px">trending_up</span> 24% increase</p>
            </div>
        </div>

        <!-- Bookings table -->
        <div class="section-card">
            <div class="section-header">
                <h2>Recent Bookings</h2>
                <div style="display:flex;gap:.5rem">
                    <button class="btn-sm" onclick="loadBookings()">
                        <span class="material-symbols-outlined" style="font-size:16px">refresh</span>
                        Refresh
                    </button>
                    <button class="btn-sm" onclick="exportBookings()">
                        <span class="material-symbols-outlined" style="font-size:16px">download</span>
                        Export
                    </button>
                </div>
            </div>
            <div style="overflow-x:auto">
                <table aria-label="Recent bookings">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Pool Size</th>
                            <th>Date</th>
                            <th>Window</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="bookings-tbody">
                        <tr class="loading-row">
                            <td colspan="6"><span class="spinner" aria-hidden="true"></span>Loading bookings…</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bottom cards -->
        <div class="bottom-grid">
            <!-- Insight -->
            <div class="insight-card">
                <div style="position:relative;z-index:1">
                    <h3>Technical Insight</h3>
                    <p>Humidity levels in Zanzibar are higher today. Adjust chlorine levels by +15% for outdoor pools to maintain clarity.</p>
                    <button class="btn-outline-white">View Chemical Guide</button>
                </div>
                <span class="material-symbols-outlined insight-icon" aria-hidden="true">thermostat</span>
            </div>

            <!-- Hero Image Upload -->
            <div class="hero-upload-card">
                <h3>Hero Image</h3>
                <p>Upload a new hero image for the homepage. Stored in Netlify Blobs — no redeploy needed.</p>
                <div class="upload-area" id="upload-area">
                    <label for="hero-file-input">
                        <span class="material-symbols-outlined upload-icon" aria-hidden="true">cloud_upload</span>
                        <div class="upload-text">
                            <strong>Click to upload</strong> or drag &amp; drop<br>
                            <span>JPEG, PNG, WebP — max 5 MB</span>
                        </div>
                        <input id="hero-file-input" type="file" accept="image/jpeg,image/png,image/webp" aria-label="Choose hero image file"/>
                    </label>
                </div>
                <div class="upload-status" id="upload-status"></div>
                <button
                    id="upload-btn"
                    style="margin-top:.75rem;width:100%;padding:.6rem;background:#0c4a6e;color:#fff;border:none;border-radius:.5rem;font-size:.82rem;font-weight:700;cursor:pointer;display:none"
                    onclick="uploadHero()"
                >
                    Upload Hero Image
                </button>
                <button
                    id="reset-hero-btn"
                    style="margin-top:.4rem;width:100%;padding:.6rem;background:#fff;color:#64748b;border:1px solid #e2e8f0;border-radius:.5rem;font-size:.78rem;font-weight:600;cursor:pointer"
                    onclick="resetHero()"
                >
                    Reset to Default
                </button>
            </div>
        </div>
    </main>
</div>

<script>
(function () {
    /* ── Auth guard ── */
    var token = sessionStorage.getItem('admin_token');
    if (!token) { window.location.replace('/tomancond'); return; }

    fetch('/api/auth', { headers: { Authorization: 'Bearer ' + token } })
        .then(function (r) { if (!r.ok) { sessionStorage.removeItem('admin_token'); window.location.replace('/tomancond'); } })
        .catch(function () { window.location.replace('/tomancond'); });

    /* ── Logout ── */
    document.getElementById('logout-btn').addEventListener('click', function (e) {
        e.preventDefault();
        fetch('/api/auth', { method: 'DELETE', headers: { Authorization: 'Bearer ' + token } })
            .finally(function () {
                sessionStorage.removeItem('admin_token');
                window.location.replace('/tomancond');
            });
    });

    /* ── Load bookings ── */
    window.loadBookings = async function () {
        var tbody = document.getElementById('bookings-tbody');
        tbody.innerHTML = '<tr class="loading-row"><td colspan="6"><span class="spinner"></span>Loading bookings…</td></tr>';

        try {
            var res = await fetch('/api/bookings', { headers: { Authorization: 'Bearer ' + token } });
            var bookings = await res.json();

            var statEl = document.getElementById('stat-bookings');
            var badgeEl = document.getElementById('jobs-badge');
            statEl.textContent = bookings.length || 0;
            badgeEl.textContent = bookings.length + ' total';

            if (!bookings.length) {
                tbody.innerHTML = '<tr class="loading-row"><td colspan="6">No bookings yet.</td></tr>';
                return;
            }

            tbody.innerHTML = bookings.slice(0, 20).map(function (b) {
                var name = escHtml(b.full_name || '—');
                var service = escHtml(b.service_type || '—');
                var size = escHtml(b.pool_size || '—');
                var date = b.preferred_date ? escHtml(b.preferred_date) : '—';
                var window_ = escHtml(b.preferred_window || '—');
                var initials = name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() || '?';
                return '<tr>' +
                    '<td><div style="display:flex;align-items:center;gap:.75rem"><div class="avatar">' + initials + '</div><span style="font-weight:600">' + name + '</span></div></td>' +
                    '<td>' + service + '</td>' +
                    '<td>' + size + '</td>' +
                    '<td>' + date + '</td>' +
                    '<td>' + window_ + '</td>' +
                    '<td><button class="btn-icon" aria-label="More options for ' + name + '"><span class="material-symbols-outlined">more_horiz</span></button></td>' +
                    '</tr>';
            }).join('');
        } catch (err) {
            tbody.innerHTML = '<tr class="loading-row"><td colspan="6" style="color:#dc2626">Failed to load bookings.</td></tr>';
        }
    };

    window.exportBookings = async function () {
        try {
            var res = await fetch('/api/bookings', { headers: { Authorization: 'Bearer ' + token } });
            var bookings = await res.json();
            var csv = 'Name,Service,Pool Size,Date,Window\n' + bookings.map(function (b) {
                return [b.full_name, b.service_type, b.pool_size, b.preferred_date, b.preferred_window]
                    .map(function (v) { return '"' + String(v || '').replace(/"/g, '""') + '"'; }).join(',');
            }).join('\n');
            var a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
            a.download = 'bookings-' + new Date().toISOString().slice(0, 10) + '.csv';
            a.click();
        } catch (e) { alert('Export failed.'); }
    };

    /* ── Hero upload ── */
    var heroFile = null;
    var fileInput = document.getElementById('hero-file-input');
    var uploadBtn = document.getElementById('upload-btn');

    fileInput.addEventListener('change', function () {
        heroFile = fileInput.files[0] || null;
        uploadBtn.style.display = heroFile ? 'block' : 'none';
        var statusEl = document.getElementById('upload-status');
        statusEl.className = 'upload-status';
        statusEl.textContent = heroFile ? 'Ready: ' + heroFile.name : '';
    });

    // Drag-and-drop
    var area = document.getElementById('upload-area');
    area.addEventListener('dragover', function (e) { e.preventDefault(); area.style.borderColor = '#0284c7'; });
    area.addEventListener('dragleave', function () { area.style.borderColor = ''; });
    area.addEventListener('drop', function (e) {
        e.preventDefault();
        area.style.borderColor = '';
        var f = e.dataTransfer.files[0];
        if (f && f.type.startsWith('image/')) {
            heroFile = f;
            uploadBtn.style.display = 'block';
            document.getElementById('upload-status').className = 'upload-status';
            document.getElementById('upload-status').textContent = 'Ready: ' + f.name;
        }
    });

    window.uploadHero = async function () {
        if (!heroFile) return;
        uploadBtn.disabled = true;
        uploadBtn.textContent = 'Uploading…';
        var statusEl = document.getElementById('upload-status');
        statusEl.className = 'upload-status';
        statusEl.textContent = '';

        try {
            var res = await fetch('/api/hero-image', {
                method: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': heroFile.type
                },
                body: heroFile
            });
            var data = await res.json();
            if (res.ok) {
                statusEl.textContent = 'Hero image updated successfully!';
                statusEl.className = 'upload-status success';
                uploadBtn.style.display = 'none';
                heroFile = null;
            } else {
                statusEl.textContent = data.error || 'Upload failed.';
                statusEl.className = 'upload-status error';
            }
        } catch (err) {
            statusEl.textContent = 'Network error.';
            statusEl.className = 'upload-status error';
        }
        uploadBtn.disabled = false;
        uploadBtn.textContent = 'Upload Hero Image';
    };

    window.resetHero = async function () {
        if (!confirm('Reset hero to default static image?')) return;
        try {
            var res = await fetch('/api/hero-image', { method: 'DELETE', headers: { Authorization: 'Bearer ' + token } });
            var data = await res.json();
            var statusEl = document.getElementById('upload-status');
            if (res.ok) {
                statusEl.textContent = 'Hero reset to default.';
                statusEl.className = 'upload-status success';
            } else {
                statusEl.textContent = data.error || 'Reset failed.';
                statusEl.className = 'upload-status error';
            }
        } catch (e) {
            alert('Network error.');
        }
    };

    /* ── Utils ── */
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* ── Init ── */
    loadBookings();
})();
</script>
</body>
</html>
